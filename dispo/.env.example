# --- Datenbank (Pflicht) ---
# DATABASE_URL       = Verbindung der laufenden Anwendung
# DIRECT_DATABASE_URL = Direktverbindung für Migrationen
#
# Lokal sind beide identisch. Bei Supabase (oder einem anderen Pooler) gehört
# in DATABASE_URL die Pooler-URL (Port 6543) und in DIRECT_DATABASE_URL die
# Direktverbindung (Port 5432) – Migrationen laufen nicht über den Pooler.
DATABASE_URL="postgresql://dispo:dispo@127.0.0.1:5432/dispo?schema=public"
DIRECT_DATABASE_URL="postgresql://dispo:dispo@127.0.0.1:5432/dispo?schema=public"

# --- 3CX Webhook (optional, nur fuer die spaetere Anbindung) ---
# Gemeinsames Geheimnis. Der Webhook muss es als Header
# `x-dispo-signature` mitsenden. Leer => Endpoint nimmt nur lokale Requests an.
THREECX_WEBHOOK_SECRET=""

# --- ERP "Das Programm" ---
# "mock" (Standard, Demodaten) oder "das-programm" (echte API).
DISPO_ERP_PROVIDER="mock"
DAS_PROGRAMM_BASE_URL=""
DAS_PROGRAMM_API_KEY=""

# --- AI-Aenderungserkennung (optional) ---
# Ohne Key laeuft eine regelbasierte Erkennung (Heuristik) lokal.
ANTHROPIC_API_KEY=""
DISPO_AI_MODEL="claude-sonnet-5"

# --- Optionaler einfacher Schutz, wenn die App oeffentlich erreichbar ist ---
# Wenn gesetzt, verlangt die App HTTP-Basic-Auth (KEINE Benutzerverwaltung!).
DISPO_BASIC_AUTH_USER=""
DISPO_BASIC_AUTH_PASSWORD=""
